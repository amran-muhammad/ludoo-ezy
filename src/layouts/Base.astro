---
import '../styles/site.css';
import type {Site, Viewer} from '../lib/types';
import {NAV, SITE} from '../content/site';

interface Props {
  site?: Site | null;
  viewer?: Viewer;
  title?: string;
  description?: string;
  isStatic?: boolean;
  noindex?: boolean;
}

const {site, title, description, isStatic = false, noindex = false} = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.name;
const pageDesc = description ?? SITE.description;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    {isStatic && <script src="/site-api/static-page.js" is:inline />}
  </head>
  <body class="min-h-full bg-background text-foreground flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-primary focus:px-3 focus:py-1.5 focus:text-primary-foreground focus:text-sm">
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b bg-background/95 backdrop-blur-sm">
      <div class="mx-auto flex h-14 max-w-5xl items-center gap-6 px-4 sm:px-6">
        <a href="/" class="font-heading text-xl font-bold tracking-tight">{site?.name ?? SITE.name}</a>
        <nav aria-label="Site" class="flex items-center gap-5 ml-2">
          {NAV.map(item => (
            <a
              href={item.href}
              aria-current={item.href === current || (item.href !== '/' && current.startsWith(item.href)) ? 'page' : undefined}
              class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors aria-[current=page]:text-foreground"
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="ml-auto flex items-center gap-3">
          <a href="/feeds" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">
            Community
          </a>
          <a href="/dashboard" class="rounded-md bg-primary px-3.5 py-1.5 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-colors">
            Dashboard
          </a>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t py-8 mt-12">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 text-sm text-muted-foreground text-center">
        {site?.name ?? SITE.name} · {SITE.tagline}
      </div>
    </footer>
  </body>
</html>
