---
/**
 * Game room page. Full-screen game UI rendered by the React island.
 * The island owns its own layout (dark game table) so no Base layout wrapper.
 */
import LudoGame from '../../components/LudoGame';
import {backend, read} from '../../server/backend';
import {pageContext} from '../../server/page';
import type {GameState} from '../../lib/ludo';
import '../../styles/site.css';

const code = (Astro.params.code ?? '').toUpperCase();
const {site, viewer} = await pageContext(Astro.request, Astro.response);
const api = backend(Astro.request);

const data = await read<{room: {code: string; status: string; state: GameState}}>(
  api.ludo.rooms[':code'].$get({param: {code}})
);

if (!data?.room) Astro.response.status = 404;
const siteName = site?.name ?? 'Ludo';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Game {code} — {siteName}</title>
    <meta name="robots" content="noindex" />
  </head>
  <body style="margin:0;padding:0;background:#1a1a2e">
    {data?.room
      ? <LudoGame client:load room={data.room} />
      : (
        <div style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;color:white;font-family:sans-serif;background:linear-gradient(135deg,#1a1a2e,#0f3460)">
          <p style="font-size:42px;margin:0">🎲</p>
          <h1 style="margin:0;font-size:24px">Room not found</h1>
          <p style="margin:0;opacity:.6">Code <strong>{code}</strong> doesn't exist or has expired.</p>
          <a href="/" style="background:#e53935;color:white;padding:10px 24px;border-radius:8px;text-decoration:none;font-weight:600;margin-top:8px">
            Start a new game
          </a>
        </div>
      )
    }
  </body>
</html>
