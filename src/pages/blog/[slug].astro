---
/**
 * One post, as an article: topic, title, standfirst, byline, cover, body, a
 * sign-up box and related posts. Rendered on the server from
 * `GET /site-api/posts/:slug` (HTML already sanitized there). An unknown slug
 * answers a real 404.
 */
import NotFound from '../../components/NotFound.astro';
import PostRow from '../../components/PostRow.astro';
import SubscribeForm from '../../components/site/SubscribeForm';
import {Avatar, AvatarFallback, AvatarGroup, AvatarImage} from '../../components/ui/avatar';
import {NEWSLETTER, SIGNUP_NOTE} from '../../content/site';
import Base from '../../layouts/Base.astro';
import {formatDate, initials, preview, readingMinutes} from '../../lib/format';
import type {Post, PostSummary} from '../../lib/types';
import {read} from '../../server/backend';
import {pageContext} from '../../server/page';

const slug = Astro.params.slug ?? '';
const {api, site, viewer} = await pageContext(Astro.request, Astro.response);
const [found, related] = await Promise.all([
  read<{post: Post}>(api.posts[':slug'].$get({param: {slug}})),
  read<{posts: PostSummary[]}>(api.posts[':slug'].related.$get({param: {slug}})),
]);
const post = found?.post ?? null;
if (!post) Astro.response.status = 404;
const name = site?.name ?? 'Community';
const topic = post?.categories[0] ?? null;
---

{
  post ? (
    <Base site={site} viewer={viewer} title={post.title} description={preview(post.excerpt, post.content)} image={post.coverUrl}>
      <article class="mx-auto max-w-3xl px-4 pt-12 sm:px-6 sm:pt-16">
        <header class="flex flex-col gap-5">
          <p class="flex flex-wrap gap-x-3 text-[0.625rem] font-semibold tracking-[0.2em] text-muted-foreground uppercase">
            <a href="/archive" class="hover:text-foreground">Archive</a>
            {topic && (
              <>
                <span aria-hidden="true">/</span>
                <a href={`/archive?topic=${topic.id}`} class="hover:text-foreground">{topic.name}</a>
              </>
            )}
          </p>
          <h1 class="text-4xl leading-[1.1] font-semibold tracking-tight sm:text-5xl">{post.title}</h1>
          {post.excerpt && <p class="font-heading text-xl leading-relaxed text-muted-foreground italic">{post.excerpt}</p>}
          <div class="flex items-center gap-3 border-y py-4">
            <AvatarGroup>
              {post.authors.slice(0, 3).map(author => (
                <Avatar className="size-10">
                  {author.avatar && <AvatarImage src={author.avatar} alt="" />}
                  <AvatarFallback>{initials(author.name)}</AvatarFallback>
                </Avatar>
              ))}
            </AvatarGroup>
            <div class="flex flex-col text-sm">
              <span class="font-semibold">{post.authors.map(author => author.name).join(', ') || name}</span>
              <span class="text-muted-foreground">
                {post.publishedAt && <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>}
                {post.publishedAt && ' · '}
                {readingMinutes(post.content)} min read
              </span>
            </div>
          </div>
        </header>

        {post.coverUrl && <img class="mt-8 aspect-[16/9] w-full bg-muted object-cover" src={post.coverUrl} alt="" />}

        <div class="article-body mt-10" set:html={post.content} />

        {post.tags.length > 0 && (
          <ul class="mt-10 flex flex-wrap gap-2" aria-label="Tags">
            {post.tags.map(tag => (
              <li class="border px-2.5 py-1 text-[0.65rem] font-semibold tracking-widest text-muted-foreground uppercase">
                {tag.name}
              </li>
            ))}
          </ul>
        )}
      </article>

      <aside class="mx-auto mt-16 max-w-3xl px-4 sm:px-6" aria-labelledby="post-signup">
        <div class="flex flex-col gap-4 border border-foreground p-6 sm:p-10">
          <h2 id="post-signup" class="text-2xl font-semibold sm:text-3xl">Enjoyed this? Get the next one on Sunday.</h2>
          <p class="text-muted-foreground">
            {NEWSLETTER.name} is free. Join {NEWSLETTER.readers} readers who get one honest look at AI products every week.
          </p>
          <SubscribeForm client:visible source="post" layout="inline" note={SIGNUP_NOTE} />
        </div>
      </aside>

      {(related?.posts.length ?? 0) > 0 && (
        <section class="mx-auto mt-16 max-w-3xl px-4 sm:px-6" aria-labelledby="keep-reading">
          <h2 id="keep-reading" class="border-b border-foreground pb-3 text-2xl font-semibold">Keep reading</h2>
          <div>{related!.posts.map(item => <PostRow post={item} />)}</div>
        </section>
      )}

      <p class="mx-auto mt-10 max-w-3xl px-4 sm:px-6">
        <a href="/archive" class="text-xs font-semibold tracking-widest uppercase hover:underline underline-offset-4">← Back to the archive</a>
      </p>
    </Base>
  ) : (
    <Base site={site} viewer={viewer} title="Page not found">
      <NotFound site={site} />
    </Base>
  )
}
