---
/** About: who writes OkayDokey and why. Static: built once, served as a file. */
import SubscribeForm from '../components/site/SubscribeForm';
import {ABOUT, NEWSLETTER, PHOTOS, SIGNUP_NOTE, withName} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
const name = site?.name ?? 'Community';
---

<Base site={site} viewer={viewer} isStatic title="About" description={ABOUT.lede}>
  <div class="mx-auto max-w-6xl px-4 pt-12 sm:px-6 sm:pt-16">
    <header class="grid gap-10 border-b border-foreground pb-12 lg:grid-cols-[1.2fr_1fr] lg:items-end">
      <div class="flex flex-col gap-5">
        <p class="text-[0.625rem] font-semibold tracking-[0.2em] text-muted-foreground uppercase">About {NEWSLETTER.name}</p>
        <h1 class="text-4xl leading-[1.05] font-semibold tracking-tight sm:text-6xl">{ABOUT.title}</h1>
        <p class="max-w-xl font-heading text-xl leading-relaxed text-muted-foreground italic">{ABOUT.lede}</p>
      </div>
      <img src={PHOTOS.about.src} alt={PHOTOS.about.alt} width="1400" height="933" class="aspect-[3/2] w-full bg-muted object-cover" loading="eager" />
    </header>

    <div class="grid gap-12 pt-12 lg:grid-cols-[1fr_18rem] lg:gap-20">
      <div class="flex max-w-2xl flex-col gap-12">
        {
          ABOUT.sections.map(section => (
            <section class="flex flex-col gap-4">
              <h2 class="text-2xl font-semibold sm:text-3xl">{section.heading}</h2>
              {section.body.map(paragraph => (
                <p class="text-[1.0625rem] leading-[1.8] text-foreground/90" data-brand-text={paragraph}>
                  {withName(paragraph, name)}
                </p>
              ))}
            </section>
          ))
        }
      </div>

      <aside class="flex flex-col gap-10 lg:sticky lg:top-24 lg:self-start">
        <div class="flex flex-col gap-6">
          <h2 class="text-[0.625rem] font-semibold tracking-[0.2em] text-muted-foreground uppercase font-sans">House rules</h2>
          <ul class="flex flex-col">
            {
              ABOUT.principles.map(item => (
                <li class="flex flex-col gap-1 border-t py-4">
                  <span class="font-heading text-lg font-semibold">{item.title}</span>
                  <span class="text-sm text-muted-foreground">{item.body}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="flex flex-col gap-4 border p-6">
          <h2 class="text-xl font-semibold">Read it on Sunday</h2>
          <SubscribeForm client:visible source="about" note={SIGNUP_NOTE} />
        </div>
      </aside>
    </div>
  </div>
</Base>
