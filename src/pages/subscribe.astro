---
/**
 * Subscribe: free vs paid, what each includes. Static: built once, served as
 * a file. The free sign-up is an island (`POST /site-api/newsletter/subscribe`);
 * paid goes through the community's own join flow (`/join`, an App page).
 */
import {CheckIcon} from 'lucide-react';

import SubscribeForm from '../components/site/SubscribeForm';
import {Badge} from '../components/ui/badge';
import {Button} from '../components/ui/button';
import {Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle} from '../components/ui/card';
import {Separator} from '../components/ui/separator';
import {NEWSLETTER, PHOTOS, SIGNUP_NOTE, SUBSCRIBE, withName} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
const name = site?.name ?? 'Community';
---

<Base site={site} viewer={viewer} isStatic title="Subscribe" description={`${NEWSLETTER.name} free and paid: what each includes.`}>
  <div class="mx-auto max-w-6xl px-4 pt-12 sm:px-6 sm:pt-16">
    <header class="flex max-w-3xl flex-col gap-5">
      <p class="text-[0.625rem] font-semibold tracking-[0.2em] text-muted-foreground uppercase">
        Subscribe to {NEWSLETTER.name} · {NEWSLETTER.readers} readers
      </p>
      <h1 class="text-4xl leading-[1.05] font-semibold tracking-tight sm:text-6xl">{SUBSCRIBE.title}</h1>
      <p class="text-lg text-muted-foreground">{SUBSCRIBE.lede}</p>
    </header>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <Card>
        <CardHeader>
          <Badge variant="secondary">{SUBSCRIBE.free.name}</Badge>
          <CardTitle className="font-heading text-4xl normal-case tracking-normal">
            {SUBSCRIBE.free.price} <span class="font-sans text-base font-normal text-muted-foreground">{SUBSCRIBE.free.period}</span>
          </CardTitle>
          <CardDescription>{SUBSCRIBE.free.summary}</CardDescription>
        </CardHeader>
        <CardContent>
          <ul class="flex flex-col gap-3 text-[0.95rem]">
            {
              SUBSCRIBE.free.items.map(item => (
                <li class="flex gap-3">
                  <CheckIcon className="mt-1 size-4 shrink-0" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </CardContent>
        <CardFooter className="mt-auto flex-col items-stretch gap-6">
          <Separator />
          <SubscribeForm client:load source="subscribe" withName note={SIGNUP_NOTE} buttonLabel="Subscribe free" />
        </CardFooter>
      </Card>

      <Card>
        <CardHeader>
          <Badge>{SUBSCRIBE.paid.name}</Badge>
          <CardTitle className="font-heading text-4xl normal-case tracking-normal">
            {NEWSLETTER.paidPrice} <span class="font-sans text-base font-normal text-muted-foreground">{NEWSLETTER.paidPeriod}</span>
          </CardTitle>
          <CardDescription>
            {SUBSCRIBE.paid.summary}
            {NEWSLETTER.paidYearly && <> Or {NEWSLETTER.paidYearly}.</>}
          </CardDescription>
        </CardHeader>
        <CardContent>
          <ul class="flex flex-col gap-3 text-[0.95rem]">
            {
              SUBSCRIBE.paid.items.map(item => (
                <li class="flex gap-3">
                  <CheckIcon className="mt-1 size-4 shrink-0" aria-hidden="true" />
                  <span data-brand-text={item}>{withName(item, name)}</span>
                </li>
              ))
            }
          </ul>
        </CardContent>
        <CardFooter className="mt-auto flex-col items-stretch gap-4">
          <Separator />
          <Button asChild size="lg">
            <a href="/join">Become a paid reader</a>
          </Button>
          <p class="text-sm text-muted-foreground">
            Paid reading runs through the <span data-brand-text="{name}">{name}</span> community: join, then choose the paid plan.
            Already a member? <a href="/login?redirectTo=%2Fsubscribe" class="underline underline-offset-4">Log in</a>.
          </p>
        </CardFooter>
      </Card>
    </div>

    <section class="mt-24 grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-20" aria-labelledby="faq">
      <div class="flex flex-col gap-6">
        <h2 id="faq" class="text-3xl font-semibold sm:text-4xl">Questions, answered</h2>
        <img src={PHOTOS.subscribe.src} alt={PHOTOS.subscribe.alt} width="1400" height="933" class="aspect-[3/2] w-full bg-muted object-cover" loading="lazy" />
      </div>
      <dl class="flex flex-col">
        {
          SUBSCRIBE.faq.map(item => (
            <div class="flex flex-col gap-2 border-t py-6 last:border-b">
              <dt class="font-heading text-xl font-semibold">{item.q}</dt>
              <dd class="leading-relaxed text-muted-foreground">{item.a}</dd>
            </div>
          ))
        }
        <div class="pt-6 text-sm text-muted-foreground">
          Something else? <a href="/contact" class="underline underline-offset-4 hover:text-foreground">Send me a message</a>.
        </div>
      </dl>
    </section>
  </div>
</Base>
