---
export const prerender = true;
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';
import {SITE} from '../content/site';

const {site} = await staticContext(Astro.request);
---

<Base site={site} title={SITE.tagline} description={SITE.description} isStatic>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-16">
    <div class="text-center mb-14">
      <h1 class="text-5xl font-bold tracking-tight mb-4">{site?.name ?? 'Ludo'}</h1>
      <p class="text-xl text-muted-foreground">{SITE.tagline}</p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 max-w-2xl mx-auto">
      <!-- Create game -->
      <div class="border rounded-xl p-8 flex flex-col gap-5 bg-card">
        <div>
          <h2 class="text-xl font-semibold mb-1">New game</h2>
          <p class="text-sm text-muted-foreground">Create a room and share the link with up to 3 friends. Unfilled spots become bots.</p>
        </div>
        <form id="create-form" class="flex flex-col gap-3" novalidate>
          <div class="flex flex-col gap-1">
            <label for="create-name" class="text-sm font-medium">Your name</label>
            <input id="create-name" name="name" type="text" maxlength="30" autocomplete="off" required
              placeholder="e.g. Alice"
              class="border rounded-md px-3 py-2 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-ring" />
            <span id="create-name-error" class="text-xs text-destructive hidden" aria-live="polite"></span>
          </div>
          <button type="submit" id="create-btn"
            class="rounded-md bg-primary text-primary-foreground px-4 py-2.5 text-sm font-semibold hover:bg-primary/90 transition-colors disabled:opacity-50 flex items-center justify-center gap-2">
            <span id="create-label">Create game</span>
          </button>
        </form>
      </div>

      <!-- Join game -->
      <div class="border rounded-xl p-8 flex flex-col gap-5 bg-card">
        <div>
          <h2 class="text-xl font-semibold mb-1">Join a game</h2>
          <p class="text-sm text-muted-foreground">Got a room code from a friend? Enter it below to join their game.</p>
        </div>
        <form id="join-form" class="flex flex-col gap-3" novalidate>
          <div class="flex flex-col gap-1">
            <label for="join-name" class="text-sm font-medium">Your name</label>
            <input id="join-name" name="name" type="text" maxlength="30" autocomplete="off" required
              placeholder="e.g. Bob"
              class="border rounded-md px-3 py-2 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-ring" />
            <span id="join-name-error" class="text-xs text-destructive hidden" aria-live="polite"></span>
          </div>
          <div class="flex flex-col gap-1">
            <label for="join-code" class="text-sm font-medium">Room code</label>
            <input id="join-code" name="code" type="text" maxlength="8" autocomplete="off" required
              placeholder="e.g. ABC123"
              class="border rounded-md px-3 py-2 text-sm bg-background uppercase tracking-widest focus:outline-none focus:ring-2 focus:ring-ring" />
            <span id="join-code-error" class="text-xs text-destructive hidden" aria-live="polite"></span>
          </div>
          <button type="submit" id="join-btn"
            class="rounded-md bg-primary text-primary-foreground px-4 py-2.5 text-sm font-semibold hover:bg-primary/90 transition-colors disabled:opacity-50 flex items-center justify-center gap-2">
            <span id="join-label">Join game</span>
          </button>
        </form>
        <span id="join-error" class="text-sm text-destructive hidden" aria-live="polite"></span>
      </div>
    </div>

    <!-- How to play -->
    <section id="how-to-play" class="mt-20 max-w-2xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">How to play</h2>
      <ol class="flex flex-col gap-4 text-sm text-muted-foreground">
        <li class="flex gap-3"><span class="font-bold text-foreground tabular-nums">1.</span><span>Create a game and share the link with friends. Wait for them to join — or press <strong class="text-foreground">Start</strong> at any time to fill empty spots with bots.</span></li>
        <li class="flex gap-3"><span class="font-bold text-foreground tabular-nums">2.</span><span>On your turn, click <strong class="text-foreground">Roll</strong> to roll the dice. You need a 6 to bring a token out of home.</span></li>
        <li class="flex gap-3"><span class="font-bold text-foreground tabular-nums">3.</span><span>Click the token you want to move. Land on an opponent's token to send them back to their home.</span></li>
        <li class="flex gap-3"><span class="font-bold text-foreground tabular-nums">4.</span><span>Get all four of your tokens to the centre to win. Rolling a 6 earns you a bonus turn.</span></li>
      </ol>
    </section>
  </div>
</Base>

<script>
// Player identity — random UUID stored in localStorage per browser.
function getOrCreatePlayerId(): string {
  try {
    let id = localStorage.getItem('ludo_player_id');
    if (!id) { id = crypto.randomUUID(); localStorage.setItem('ludo_player_id', id); }
    return id;
  } catch { return crypto.randomUUID(); }
}

function showError(el: HTMLElement | null, msg: string) {
  if (!el) return;
  el.textContent = msg;
  el.classList.remove('hidden');
}
function clearError(el: HTMLElement | null) {
  if (!el) return;
  el.textContent = '';
  el.classList.add('hidden');
}

function setBusy(btn: HTMLButtonElement, label: HTMLElement | null, busy: boolean, text = 'Creating…') {
  btn.disabled = busy;
  btn.setAttribute('aria-busy', String(busy));
  if (label) label.textContent = busy ? text : btn.dataset.default!;
}

// ── Create form ──────────────────────────────────────────────────────────────
const createForm = document.getElementById('create-form') as HTMLFormElement;
const createBtn = document.getElementById('create-btn') as HTMLButtonElement;
const createLabel = document.getElementById('create-label') as HTMLElement;
createBtn.dataset.default = createLabel.textContent!;

createForm.addEventListener('submit', async e => {
  e.preventDefault();
  const nameInput = createForm.querySelector<HTMLInputElement>('#create-name')!;
  const nameError = document.getElementById('create-name-error');
  const name = nameInput.value.trim();
  clearError(nameError);
  if (!name) { showError(nameError, 'Enter your name.'); nameInput.focus(); return; }

  setBusy(createBtn, createLabel, true, 'Creating…');
  try {
    const res = await fetch('/site-api/ludo/rooms', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({name, playerId: getOrCreatePlayerId()}),
    });
    const data = await res.json() as {code?: string; message?: string};
    if (!res.ok || !data.code) { showError(nameError, data.message ?? 'Something went wrong.'); return; }
    localStorage.setItem('ludo_name', name);
    window.location.href = `/game/${data.code}`;
  } catch {
    showError(nameError, 'Could not reach the server. Try again.');
  } finally {
    setBusy(createBtn, createLabel, false);
  }
});

// ── Join form ────────────────────────────────────────────────────────────────
const joinForm = document.getElementById('join-form') as HTMLFormElement;
const joinBtn = document.getElementById('join-btn') as HTMLButtonElement;
const joinLabel = document.getElementById('join-label') as HTMLElement;
joinBtn.dataset.default = joinLabel.textContent!;

joinForm.addEventListener('submit', async e => {
  e.preventDefault();
  const nameInput = joinForm.querySelector<HTMLInputElement>('#join-name')!;
  const codeInput = joinForm.querySelector<HTMLInputElement>('#join-code')!;
  const nameError = document.getElementById('join-name-error');
  const codeError = document.getElementById('join-code-error');
  const joinError = document.getElementById('join-error');
  clearError(nameError); clearError(codeError); clearError(joinError);

  const name = nameInput.value.trim();
  const code = codeInput.value.trim().toUpperCase();
  let ok = true;
  if (!name) { showError(nameError, 'Enter your name.'); ok = false; }
  if (!code) { showError(codeError, 'Enter a room code.'); ok = false; }
  if (!ok) { if (!name) nameInput.focus(); else codeInput.focus(); return; }

  setBusy(joinBtn, joinLabel, true, 'Joining…');
  try {
    const res = await fetch(`/site-api/ludo/rooms/${code}/join`, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({name, playerId: getOrCreatePlayerId()}),
    });
    const data = await res.json() as {code?: string; message?: string; error?: string};
    if (!res.ok) {
      if (data.error === 'not_found') showError(codeError, 'Room not found. Check the code and try again.');
      else if (data.error === 'full') showError(joinError, 'That room is already full.');
      else if (data.error === 'already_started') showError(joinError, 'That game has already started.');
      else showError(joinError, data.message ?? 'Something went wrong.');
      return;
    }
    localStorage.setItem('ludo_name', name);
    window.location.href = `/game/${data.code ?? code}`;
  } catch {
    showError(joinError, 'Could not reach the server. Try again.');
  } finally {
    setBusy(joinBtn, joinLabel, false);
  }
});
</script>
