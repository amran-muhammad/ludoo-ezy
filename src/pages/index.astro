---
/**
 * The home page: PRERENDERED (built once, served as a static file, no server
 * work per visit). Words in `src/content/site.ts`.
 *
 * Filled in by the browser after load:
 *   - the visitor (`<Base isStatic>`), and the two sign-up boxes (islands);
 *   - the latest posts (`data-live="posts"`), hidden while there are none.
 */
import SubscribeForm from '../components/site/SubscribeForm';
import {Button} from '../components/ui/button';
import {HOME, NEWSLETTER, PHOTOS, SIGNUP_NOTE, withName} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
const name = site?.name ?? 'Community';
/** `{readers}` is filled now; `{name}` stays for the browser to refresh after a rename. */
const brandText = (text: string) => text.replaceAll('{readers}', NEWSLETTER.readers);
const initialsOf = (who: string) =>
  who
    .split(/\s+/)
    .map(part => part[0] ?? '')
    .join('')
    .slice(0, 2);
---

<Base site={site} viewer={viewer} isStatic description={`${NEWSLETTER.name}: ${NEWSLETTER.tagline}`}>
  <!-- Hero: what it is, and the sign-up box, above the fold on a phone. -->
  <section class="mx-auto grid max-w-6xl gap-12 px-4 pt-12 pb-16 sm:px-6 sm:pt-20 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16">
    <div class="flex flex-col gap-6">
      <p class="text-[0.625rem] font-semibold tracking-[0.2em] text-muted-foreground uppercase">
        <span data-brand-text={HOME.hero.eyebrow}>{withName(HOME.hero.eyebrow, name)}</span>
        <span aria-hidden="true"> · </span>{NEWSLETTER.cadence}
      </p>
      <h1 class="text-[2.6rem] leading-[1.05] font-semibold tracking-tight sm:text-6xl">
        <span class="block italic font-normal">{NEWSLETTER.name}.</span>
        {HOME.hero.title}
      </h1>
      <p class="max-w-xl text-lg leading-relaxed text-muted-foreground">{HOME.hero.body}</p>
      <div class="max-w-lg pt-2">
        <SubscribeForm client:load source="home" layout="inline" note={SIGNUP_NOTE} />
      </div>
      <p class="text-sm text-muted-foreground">
        Read by <strong class="font-semibold text-foreground">{NEWSLETTER.readers}</strong> curious people ·
        <a href="/archive" class="underline underline-offset-4 hover:text-foreground">Read past issues first</a>
      </p>
    </div>
    <figure class="flex flex-col gap-3">
      <img
        src={PHOTOS.home.src}
        alt={PHOTOS.home.alt}
        width="1600"
        height="1200"
        class="aspect-[4/3] w-full bg-muted object-cover lg:aspect-[4/5]"
        fetchpriority="high"
      />
      <figcaption class="text-xs text-muted-foreground">Where the Sunday issue gets written.</figcaption>
    </figure>
  </section>

  <!-- What you get: the four parts of every issue. -->
  <section class="border-y bg-card" aria-labelledby="what-you-get">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="flex max-w-2xl flex-col gap-3">
        <h2 id="what-you-get" class="text-3xl font-semibold sm:text-4xl">{HOME.features.title}</h2>
        <p class="text-muted-foreground">{HOME.features.lede}</p>
      </div>
      <ol class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2">
        {
          HOME.features.items.map((item, index) => (
            <li class="flex gap-5 border-t border-foreground pt-6">
              <span class="font-heading text-3xl text-muted-foreground tabular-nums" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="flex flex-col gap-2">
                <h3 class="text-xl font-semibold">{item.title}</h3>
                <p class="leading-relaxed text-muted-foreground">{item.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Latest posts, from the community's blog (hidden until some arrive). -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20" data-live="posts" aria-labelledby="latest" hidden>
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-foreground pb-4">
      <h2 id="latest" class="text-3xl font-semibold sm:text-4xl">The latest issues</h2>
      <a href="/archive" class="text-xs font-semibold tracking-widest uppercase hover:underline underline-offset-4">Browse the archive →</a>
    </div>
    <div class="grid gap-x-12 md:grid-cols-2" data-list></div>
  </section>

  <!-- Reader quotes. PLACEHOLDER: replace them in src/content/site.ts. -->
  <section class="bg-muted/50" aria-labelledby="readers">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 id="readers" class="text-3xl font-semibold sm:text-4xl">What readers say</h2>
      <div class="mt-10 grid gap-10 md:grid-cols-3">
        {
          HOME.quotes.map(quote => (
            <figure class="flex flex-col gap-5">
              <blockquote class="font-heading text-xl leading-snug italic">“{quote.text}”</blockquote>
              <figcaption class="mt-auto flex items-center gap-3">
                <span
                  class="inline-flex size-9 items-center justify-center rounded-full bg-background text-xs font-semibold text-muted-foreground ring-1 ring-border"
                  aria-hidden="true">
                  {initialsOf(quote.author)}
                </span>
                <span class="flex flex-col text-sm">
                  <span class="font-semibold">{quote.author}</span>
                  <span class="text-muted-foreground">{quote.role}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- The last call to subscribe. -->
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 sm:pt-20" aria-labelledby="cta">
    <div class="grid gap-10 border border-foreground p-6 sm:p-10 lg:grid-cols-2 lg:items-center lg:p-14">
      <div class="flex flex-col gap-3">
        <h2 id="cta" class="text-3xl font-semibold sm:text-4xl">{HOME.cta.title}</h2>
        <p class="text-muted-foreground" data-brand-text={brandText(HOME.cta.body)}>{withName(HOME.cta.body, name)}</p>
        <div class="pt-2">
          <Button asChild variant="link" className="px-0">
            <a href="/subscribe">Compare free and paid →</a>
          </Button>
        </div>
      </div>
      <SubscribeForm client:visible source="home-bottom" withName note={SIGNUP_NOTE} buttonLabel="Send me Sunday’s issue" />
    </div>
  </section>
</Base>

<script>
  import {formatDate} from '../lib/format';
  import type {PostsPage} from '../lib/types';

  /** One element with text: never HTML from an answer. */
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = '') => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  };

  async function latestPosts() {
    const section = document.querySelector<HTMLElement>('[data-live="posts"]');
    const list = section?.querySelector<HTMLElement>('[data-list]');
    if (!section || !list) return;
    try {
      const res = await fetch('/site-api/posts?perPage=4', {headers: {accept: 'application/json'}});
      if (!res.ok) return;
      const data = (await res.json()) as PostsPage;
      for (const post of data.posts) {
        const article = el('article', 'group relative flex flex-col gap-2 border-b py-8');
        const meta = el('p', 'text-[0.625rem] font-semibold tracking-widest text-muted-foreground uppercase');
        meta.textContent = [formatDate(post.publishedAt), post.categories[0]?.name].filter(Boolean).join(' · ');
        const heading = el('h3', 'text-xl leading-snug font-semibold sm:text-2xl');
        const link = el('a', 'after:absolute after:inset-0 decoration-1 underline-offset-4 group-hover:underline', post.title);
        link.href = `/blog/${encodeURIComponent(post.slug)}`;
        heading.append(link);
        article.append(meta, heading);
        if (post.excerpt) {
          const text = post.excerpt.length > 160 ? `${post.excerpt.slice(0, 160).trimEnd()}…` : post.excerpt;
          article.append(el('p', 'leading-relaxed text-muted-foreground', text));
        }
        list.append(article);
      }
      if (data.posts.length > 0) section.hidden = false;
    } catch {
      // The section stays hidden: the page is complete without it.
    }
  }

  void latestPosts();
</script>
