---
/**
 * The branded 404 body — rendered by `pages/404.astro` for any address with no
 * page, and by the post page for an unknown slug. Both set a 404 status.
 */
import {Button} from './ui/button';
import type {Site} from '../lib/types';

interface Props {
  site: Site | null;
}

const {site} = Astro.props;
---

<section class="mx-auto flex max-w-2xl flex-col items-start gap-5 px-4 py-24 sm:px-6">
  <p class="text-[0.625rem] font-semibold tracking-[0.2em] text-muted-foreground uppercase">Error 404</p>
  <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">This page isn’t in the archive</h1>
  <p class="text-lg text-muted-foreground">
    The address may be mistyped, or the post may have moved. Everything {site?.name ?? 'we'} published is in the archive.
  </p>
  <div class="flex flex-wrap gap-3">
    <Button asChild><a href="/archive">Browse the archive</a></Button>
    <Button asChild variant="outline"><a href="/">Back to home</a></Button>
  </div>
</section>
