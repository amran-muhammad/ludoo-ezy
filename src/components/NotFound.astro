---
import type {Site} from '../lib/types';

interface Props {
  site?: Site | null;
}
---

<section class="mx-auto flex max-w-xl flex-col items-center gap-5 px-4 py-24 text-center sm:px-6">
  <p class="text-xs font-semibold tracking-widest text-muted-foreground uppercase">404</p>
  <h1 class="text-3xl font-bold tracking-tight">Page not found</h1>
  <p class="text-muted-foreground">That address doesn't exist. Head back and start a new game.</p>
  <a href="/" class="rounded-md bg-primary text-primary-foreground px-5 py-2.5 text-sm font-semibold hover:bg-primary/90 transition-colors">
    Go home
  </a>
</section>
