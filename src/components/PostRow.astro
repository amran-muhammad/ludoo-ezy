---
/** One story in a list: date, title, excerpt, topic and a cover thumbnail. */
import type {PostSummary} from '../lib/types';
import {formatDate, preview} from '../lib/format';

interface Props {
  post: PostSummary;
  /** `h2` on the Archive, `h3` under a section heading. */
  heading?: 'h2' | 'h3';
}

const {post, heading: Heading = 'h3'} = Astro.props;
const topic = post.categories[0];
---

<article class="group relative grid gap-5 border-b py-8 sm:grid-cols-[1fr_10rem] sm:gap-8">
  <div class="flex min-w-0 flex-col gap-2">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.625rem] font-semibold tracking-widest text-muted-foreground uppercase">
      {post.publishedAt && <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>}
      {topic && <span aria-hidden="true">·</span>}
      {topic && <span>{topic.name}</span>}
    </p>
    <Heading class="text-xl leading-snug font-semibold sm:text-2xl">
      <a href={`/blog/${encodeURIComponent(post.slug)}`} class="after:absolute after:inset-0 group-hover:underline decoration-1 underline-offset-4">
        {post.title}
      </a>
    </Heading>
    {post.excerpt && <p class="text-[0.95rem] leading-relaxed text-muted-foreground">{preview(post.excerpt, undefined, 180)}</p>}
  </div>
  {
    post.coverUrl && (
      <img
        class="order-first aspect-[3/2] w-full bg-muted object-cover sm:order-none"
        src={post.coverUrl}
        alt=""
        loading="lazy"
        decoding="async"
      />
    )
  }
</article>
